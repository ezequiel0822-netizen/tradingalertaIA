TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_VERSION=v2.3.0

DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1

MIN_LIQUIDITY_USD=10000
MIN_VOLUME_5M_USD=5000
MIN_VOLUME_1H_USD=15000
ALERT_SCORE_THRESHOLD=65
CRITICAL_RISK_ALERTS=true
ALERT_CRITICAL_RISKS_WITHOUT_GAIN=false
MIN_ESTIMATED_GAIN_PCT=500
MIN_ESTIMATE_CONFIDENCE=45

POLL_INTERVAL_SECONDS=60
MAX_ALERTS_PER_RUN=10
DEDUP_WINDOW_MINUTES=360
MAX_SNAPSHOTS_PER_RUN=80
MAX_SECURITY_CHECKS_PER_RUN=25
ALERT_CAP_WINDOW_HOURS=24
MEMECOIN_MAX_ALERTS_PER_24H=5
STOCK_MAX_ALERTS_PER_24H=5
MEMECOIN_MAX_ALERTS_PER_RUN=2
STOCK_MAX_ALERTS_PER_RUN=2

ENABLE_STOCK_ALERTS=true
STOCK_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMD,META,AMZN,GOOGL,SPY,QQQ,COIN,MSTR,PLTR,SMCI
MIN_STOCK_ESTIMATED_GAIN_PCT=8
MIN_STOCK_ESTIMATE_CONFIDENCE=55

ENABLE_TELEGRAM_ASSISTANT=true
TELEGRAM_ASSISTANT_MAX_UPDATES=10
ENABLE_ADVANCED_MARKET_INTEL=true
ENABLE_PRO_INTELLIGENCE=true
ENABLE_NEWS_INTEL=true
MAX_CHART_ANALYSES_PER_RUN=6
MAX_NEWS_PER_SYMBOL=5
ENABLE_SEC_FILINGS_INTEL=true
MAX_SEC_FILINGS_PER_RUN=6
MAX_SEC_FILINGS_PER_SYMBOL=5
SEC_RECENT_DAYS=14
SEC_USER_AGENT=TradingAlertAI/2.3.0 local-read-only contact@example.com
ENABLE_OBSIDIAN_MEMORY=true
OBSIDIAN_VAULT_PATH=obsidian/tradingbot v.1
REQUEST_TIMEOUT_SECONDS=15

ENABLE_LEARNING_ENGINE=true
LEARNING_MIN_ALERT_AGE_MINUTES=60
LEARNING_MAX_ALERTS_PER_RUN=300
ENABLE_PAPER_TRADING=true
PAPER_TRADE_MAX_ACTIVE=20
READINESS_MIN_SCORE=75
READINESS_MIN_CONFIDENCE=65
OUTCOME_WIN_RETURN_MEMECOIN_PCT=100
OUTCOME_WIN_RETURN_STOCK_PCT=5
OUTCOME_LOSS_RETURN_MEMECOIN_PCT=-40
OUTCOME_LOSS_RETURN_STOCK_PCT=-3

# Fase 1 v1.6.0 - aprendizaje por horizonte y backtesting (read-only)
ENABLE_PRICE_SNAPSHOTS=true
SNAPSHOT_RETENTION_DAYS=30
HORIZON_MIN_SNAPSHOTS=2
ENABLE_HORIZON_EVALUATOR=true
BACKTEST_MIN_SAMPLES=5
BACKTEST_DEFAULT_HORIZON_HOURS=24
ENABLE_WEEKLY_OBSIDIAN_REPORT=true

# Fase 2 v1.7.0 - paper trading++, pesos aprendidos, learning gate, forex/oro foundation
# Sigue read-only. Sin order_send a brokers ni demo MT5 todavia.
ENABLE_ATR_BASED_SLTP=true
ATR_STOP_MULTIPLIER=2.0
ATR_TP1_MULTIPLIER=2.0
ATR_TP2_MULTIPLIER=4.0
ENABLE_TRAILING_STOP=true
TRAILING_ACTIVATION_PCT_STOCK=5.0
TRAILING_ACTIVATION_PCT_MEMECOIN=50.0
TRAILING_DISTANCE_PCT_STOCK=3.0
TRAILING_DISTANCE_PCT_MEMECOIN=25.0
# Pesos aprendidos y learning gate quedan OFF por default. Activar cuando haya
# suficientes strategy_lessons y outcomes por horizonte (revisar /aprendizaje
# y /backtest antes de prender).
ENABLE_LEARNED_WEIGHTS=false
LEARNED_WEIGHTS_MIN_SAMPLES=5
LEARNED_WEIGHTS_MIN_CONFIDENCE=40
LEARNED_WEIGHTS_PER_FEATURE_MAX=3.0
LEARNED_WEIGHTS_MAX_ADJUSTMENT=10.0
ENABLE_LEARNING_GATE=false
LEARNING_GATE_MIN_WIN_RATE=0.45
LEARNING_GATE_MIN_SAMPLES=10
LEARNING_GATE_HORIZON_HOURS=24
LEARNING_GATE_SINCE_DAYS=30
# Forex y oro: collector via Yahoo Finance (HTTP). Solo persiste snapshots,
# NO genera alertas Telegram en Fase 2. Las alertas forex/oro vendran en Fase 3.
ENABLE_FOREX_COLLECTOR=true
FOREX_SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X,USDCHF=X,AUDUSD=X,USDCAD=X,NZDUSD=X,GC=F

# Fase 2.5 v2.0.0 - trader engine + MT5 reader (read-only).
# Sigue sin order_send a brokers ni demo MT5 todavia (eso es Fase 5).
# Memecoins quedan como lab de aprendizaje (no Telegram, no paper trades).
ACCOUNT_STARTING_BALANCE=10000
MAX_OPEN_TRADES_TOTAL=5
MAX_OPEN_TRADES_STOCK=3
MAX_OPEN_TRADES_FOREX=4
MAX_OPEN_TRADES_GOLD=2
RISK_PER_TRADE_PCT=1.0
MAX_TOTAL_RISK_PCT=6.0
MAX_DAILY_DRAWDOWN_PCT=3.0
KILL_SWITCH_COOLDOWN_HOURS=24
ENABLE_KILL_SWITCH_AUTO=true
ENABLE_STRATEGY_ROUTER=true
STRATEGY_MIN_CONFIDENCE=60
ENABLE_STRATEGY_BREAKOUT=true
ENABLE_STRATEGY_MEAN_REVERSION=true
ENABLE_STRATEGY_MOMENTUM=true
ENABLE_STRATEGY_NEWS_CATALYST=true
ENABLE_PARTIAL_CLOSE_AT_TP1=true
PARTIAL_CLOSE_FRACTION=0.5
ENABLE_TIME_BASED_EXIT=true
DEFAULT_TIME_HORIZON_HOURS=48
ENABLE_INVALIDATION_EXIT=true
LIFECYCLE_REEVAL_EVERY_N_CYCLES=5
ENABLE_MEMECOIN_TELEGRAM=false
ENABLE_MACRO_CONTEXT=true
ENABLE_TRADE_ACTION_REPORTS=true
# MT5 read-only (Windows + MetaTrader5 package). Soft-fail si no disponible.
# Las credenciales reales van SOLO en tu .env (nunca aqui).
ENABLE_MT5_READER=false
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_CONNECTION_TIMEOUT_MS=5000

# Phase 3 v2.2.0 - forex price-action + dashboard avanzado
ENABLE_MACRO_COLLECTOR=true
MACRO_COLLECTOR_INTERVAL_MINUTES=60
ENABLE_ECONOMIC_CALENDAR=true
CALENDAR_BUFFER_MINUTES=30
CALENDAR_REFRESH_HOURS=12
ENABLE_STRATEGY_FOREX_SESSION_BREAKOUT=true
ENABLE_FOREX_ALERTS=true
ENABLE_GOLD_ALERTS=true
MAX_FOREX_ALERTS_PER_24H=3
MAX_GOLD_ALERTS_PER_24H=2
MAX_FOREX_ALERTS_PER_RUN=1
MAX_GOLD_ALERTS_PER_RUN=1

# Phase 3.5 v2.2.0 - LLM integration (Claude API)
# Soft-fail: si ANTHROPIC_API_KEY vacio o paquete anthropic no instalado,
# el bot sigue corriendo sin Claude. Tu API key vive SOLO aqui en .env real.
ANTHROPIC_API_KEY=
ENABLE_CLAUDE_INTEGRATION=false
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_CALLS_PER_CYCLE_CAP=6
CLAUDE_CACHE_TTL_SECONDS=3600
CLAUDE_MAX_COST_PER_DAY_USD=2.0

# Phase 4 v2.3.0 - MT5 validation + walk-forward + data quality + CSV
# Broker profile para symbol mapping Yahoo<->MT5 (icmarkets default).
MT5_BROKER_PROFILE=icmarkets
# Walk-forward backtester out-of-sample (detecta curve-fitting).
ENABLE_WALK_FORWARD_BACKTEST=true
WALK_FORWARD_TRAIN_DAYS=14
WALK_FORWARD_TEST_DAYS=7
WALK_FORWARD_SLIDE_DAYS=1
WALK_FORWARD_MIN_TRAIN_SAMPLES=10
# Data quality monitor (gaps + staleness + collector failures).
ENABLE_DATA_QUALITY_MONITOR=true
DATA_QUALITY_CHECK_EVERY_N_CYCLES=10
DATA_QUALITY_STALENESS_MAX_MINUTES=15
DATA_QUALITY_GAP_THRESHOLD_MULTIPLIER=2.0
# CSV exports (outcomes, paper trades, horizons, walk-forward).
ENABLE_CSV_EXPORT=true
CSV_EXPORT_PATH=exports

CHAINS_TO_MONITOR=solana,ethereum,base,bsc
