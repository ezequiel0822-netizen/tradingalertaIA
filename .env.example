TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_VERSION=v3.6.0

DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1

MIN_LIQUIDITY_USD=10000
MIN_VOLUME_5M_USD=5000
MIN_VOLUME_1H_USD=15000
ALERT_SCORE_THRESHOLD=65
CRITICAL_RISK_ALERTS=true
ALERT_CRITICAL_RISKS_WITHOUT_GAIN=false
MIN_ESTIMATED_GAIN_PCT=500
MIN_ESTIMATE_CONFIDENCE=45

# v3.9.5: default 120. El ciclo tarda ~35-90s; con 60 el bot corria sin dormir
# 24/7 y quemaba ~100k hits/dia a Yahoo (429 autoinfligido). Para swing sobre
# velas de 15m, 120-180 no pierde nada.
POLL_INTERVAL_SECONDS=120
MAX_ALERTS_PER_RUN=10
DEDUP_WINDOW_MINUTES=360
MAX_SNAPSHOTS_PER_RUN=80
MAX_SECURITY_CHECKS_PER_RUN=25
ALERT_CAP_WINDOW_HOURS=24
MEMECOIN_MAX_ALERTS_PER_24H=5
STOCK_MAX_ALERTS_PER_24H=5
MEMECOIN_MAX_ALERTS_PER_RUN=2
STOCK_MAX_ALERTS_PER_RUN=2

ENABLE_STOCK_ALERTS=true
# v2.9.1 - controla SOLO si las alertas de candidatos de acciones van a Telegram.
# El analisis/aprendizaje de acciones (collector + scoring + paper trades) sigue
# aunque sea false. NO afecta los avisos de apertura/cierre de trades. Poner false
# para "analizar acciones pero no alertarlas".
ENABLE_STOCK_TELEGRAM=true
STOCK_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMD,META,AMZN,GOOGL,SPY,QQQ,COIN,MSTR,PLTR,SMCI,NFLX,GLD,XOM,CVX,BAC,SLV,USO,TNA
MIN_STOCK_ESTIMATED_GAIN_PCT=8
MIN_STOCK_ESTIMATE_CONFIDENCE=55

ENABLE_TELEGRAM_ASSISTANT=true
TELEGRAM_ASSISTANT_MAX_UPDATES=10
ENABLE_ADVANCED_MARKET_INTEL=true
ENABLE_PRO_INTELLIGENCE=true
ENABLE_NEWS_INTEL=true
MAX_CHART_ANALYSES_PER_RUN=6
MAX_NEWS_PER_SYMBOL=5
ENABLE_SEC_FILINGS_INTEL=true
MAX_SEC_FILINGS_PER_RUN=6
MAX_SEC_FILINGS_PER_SYMBOL=5
SEC_RECENT_DAYS=14
SEC_USER_AGENT=TradingAlertAI/2.5.3 local-read-only contact@example.com
ENABLE_OBSIDIAN_MEMORY=true
OBSIDIAN_VAULT_PATH=obsidian/tradingbot v.1
REQUEST_TIMEOUT_SECONDS=15

ENABLE_LEARNING_ENGINE=true
LEARNING_MIN_ALERT_AGE_MINUTES=60
LEARNING_MAX_ALERTS_PER_RUN=300
ENABLE_PAPER_TRADING=true
PAPER_TRADE_MAX_ACTIVE=20
READINESS_MIN_SCORE=75
READINESS_MIN_CONFIDENCE=65
OUTCOME_WIN_RETURN_MEMECOIN_PCT=100
OUTCOME_WIN_RETURN_STOCK_PCT=5
OUTCOME_LOSS_RETURN_MEMECOIN_PCT=-40
OUTCOME_LOSS_RETURN_STOCK_PCT=-3

# Fase 1 v1.6.0 - aprendizaje por horizonte y backtesting (read-only)
ENABLE_PRICE_SNAPSHOTS=true
SNAPSHOT_RETENTION_DAYS=30
HORIZON_MIN_SNAPSHOTS=2
ENABLE_HORIZON_EVALUATOR=true
BACKTEST_MIN_SAMPLES=5
BACKTEST_DEFAULT_HORIZON_HOURS=24
ENABLE_WEEKLY_OBSIDIAN_REPORT=true

# Fase 2 v1.7.0 - paper trading++, pesos aprendidos, learning gate, forex/oro foundation
# Sigue read-only. Sin order_send a brokers ni demo MT5 todavia.
ENABLE_ATR_BASED_SLTP=true
ATR_STOP_MULTIPLIER=2.0
ATR_TP1_MULTIPLIER=2.0
ATR_TP2_MULTIPLIER=4.0
ENABLE_TRAILING_STOP=true
TRAILING_ACTIVATION_PCT_STOCK=5.0
TRAILING_ACTIVATION_PCT_MEMECOIN=50.0
TRAILING_DISTANCE_PCT_STOCK=3.0
TRAILING_DISTANCE_PCT_MEMECOIN=25.0
# Pesos aprendidos y learning gate quedan OFF por default. Activar cuando haya
# suficientes strategy_lessons y outcomes por horizonte (revisar /aprendizaje
# y /backtest antes de prender).
ENABLE_LEARNED_WEIGHTS=false
LEARNED_WEIGHTS_MIN_SAMPLES=5
LEARNED_WEIGHTS_MIN_CONFIDENCE=40
LEARNED_WEIGHTS_PER_FEATURE_MAX=3.0
LEARNED_WEIGHTS_MAX_ADJUSTMENT=10.0
ENABLE_LEARNING_GATE=false
LEARNING_GATE_MIN_WIN_RATE=0.45
LEARNING_GATE_MIN_SAMPLES=10
LEARNING_GATE_HORIZON_HOURS=24
LEARNING_GATE_SINCE_DAYS=30
# Forex y oro: collector via Yahoo Finance (HTTP). Solo persiste snapshots,
# NO genera alertas Telegram en Fase 2. Las alertas forex/oro vendran en Fase 3.
ENABLE_FOREX_COLLECTOR=true
FOREX_SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X,USDCHF=X,AUDUSD=X,USDCAD=X,NZDUSD=X,GC=F

# Fase 2.5 v2.0.0 - trader engine + MT5 reader (read-only).
# Sigue sin order_send a brokers ni demo MT5 todavia (eso es Fase 5).
# Memecoins quedan como lab de aprendizaje (no Telegram, no paper trades).
ACCOUNT_STARTING_BALANCE=10000
MAX_OPEN_TRADES_TOTAL=5
MAX_OPEN_TRADES_STOCK=3
MAX_OPEN_TRADES_FOREX=4
MAX_OPEN_TRADES_GOLD=2
RISK_PER_TRADE_PCT=1.0
MAX_TOTAL_RISK_PCT=6.0
MAX_DAILY_DRAWDOWN_PCT=3.0
KILL_SWITCH_COOLDOWN_HOURS=24
ENABLE_KILL_SWITCH_AUTO=true
ENABLE_STRATEGY_ROUTER=true
STRATEGY_MIN_CONFIDENCE=60
ENABLE_STRATEGY_BREAKOUT=true
ENABLE_STRATEGY_MEAN_REVERSION=true
ENABLE_STRATEGY_MOMENTUM=true
ENABLE_STRATEGY_NEWS_CATALYST=true
ENABLE_PARTIAL_CLOSE_AT_TP1=true
PARTIAL_CLOSE_FRACTION=0.5
ENABLE_TIME_BASED_EXIT=true
DEFAULT_TIME_HORIZON_HOURS=48
ENABLE_INVALIDATION_EXIT=true
LIFECYCLE_REEVAL_EVERY_N_CYCLES=5
ENABLE_MEMECOIN_TELEGRAM=false
ENABLE_MACRO_CONTEXT=true
ENABLE_TRADE_ACTION_REPORTS=true
# MT5 read-only (Windows + MetaTrader5 package). Soft-fail si no disponible.
# Las credenciales reales van SOLO en tu .env (nunca aqui).
ENABLE_MT5_READER=false
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_CONNECTION_TIMEOUT_MS=5000

# Phase 3 v2.2.0 - forex price-action + dashboard avanzado
ENABLE_MACRO_COLLECTOR=true
MACRO_COLLECTOR_INTERVAL_MINUTES=60
# v3.9.0 - COT collector (CFTC semanal, gratis): captura posicionamiento institucional
# de los futuros de divisas + oro que el bot opera. Solo CAPTURA para research (no genera
# senal ni gate). Opt-in OFF; data semanal -> chequeo 2x/dia (720 min).
ENABLE_COT_COLLECTOR=false
COT_COLLECTOR_INTERVAL_MINUTES=720
ENABLE_ECONOMIC_CALENDAR=true
CALENDAR_BUFFER_MINUTES=30
CALENDAR_REFRESH_HOURS=12
ENABLE_STRATEGY_FOREX_SESSION_BREAKOUT=true
ENABLE_FOREX_ALERTS=true
ENABLE_GOLD_ALERTS=true
MAX_FOREX_ALERTS_PER_24H=3
MAX_GOLD_ALERTS_PER_24H=2
MAX_FOREX_ALERTS_PER_RUN=1
MAX_GOLD_ALERTS_PER_RUN=1

# Phase 3.5 v2.2.0 - LLM integration (Claude API)
# Soft-fail: si ANTHROPIC_API_KEY vacio o paquete anthropic no instalado,
# el bot sigue corriendo sin Claude. Tu API key vive SOLO aqui en .env real.
ANTHROPIC_API_KEY=
ENABLE_CLAUDE_INTEGRATION=false
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_CALLS_PER_CYCLE_CAP=6
CLAUDE_CACHE_TTL_SECONDS=3600
CLAUDE_MAX_COST_PER_DAY_USD=2.0

# Phase v2.10.0 - LLM LOCAL via Ollama (gratis, sin API key). Alternativa a Claude.
# Si ENABLE_OLLAMA_INTEGRATION=true, el bot usa Ollama en vez de Claude para
# enriquecer texto (resumenes/analisis/free-text). Soft-fail: si Ollama no corre,
# el bot funciona igual que sin LLM. NO toca decisiones de trading.
# Para usar: instalar Ollama (ollama.com) + `ollama pull llama3.1` + dejarlo corriendo.
ENABLE_OLLAMA_INTEGRATION=false
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_CALLS_PER_CYCLE_CAP=6

# Phase v2.11.0 - Capa LLM ASESORA (TradingReasoner). Sobre el LLM local (Ollama),
# genera TEXTO de ayuda: evaluacion de mercado, post-mortem de perdidas, explicar
# setups. READ-ONLY: NO decide ni ejecuta trades (solo texto). Requiere
# ENABLE_OLLAMA_INTEGRATION=true. Soft-fail: si esta off o Ollama no corre, igual.
ENABLE_LLM_ADVISOR=false

# Phase v3.0.0 - Veto del ensemble LLM en el gate (Fase B p2). DOS modelos locales
# (primario + 2da opinion) buscan red flags en un trade que las reglas YA aprobaron;
# si cualquiera marca, el trade baja a paper-only (downward-only, NUNCA habilita una
# orden). Requiere ENABLE_OLLAMA_INTEGRATION=true. Soft-fail: off o sin Ollama -> igual.
ENABLE_LLM_ENSEMBLE=false
OLLAMA_SECOND_MODEL=mistral

# Phase v3.1.0 - Resumen diario por Telegram al cierre NY (Fase B p3). 1x/dia tras la
# hora de corte (UTC) manda los trades del dia (ganados/perdidos/R neto) + una leccion
# via LLM local (opcional). READ-ONLY. Los numeros se mandan aunque Ollama este off;
# la leccion requiere ENABLE_LLM_ADVISOR=true. DAILY_SUMMARY_HOUR_UTC: 21 = ~cierre NY.
ENABLE_DAILY_SUMMARY=false
DAILY_SUMMARY_HOUR_UTC=21

# Phase v3.2.0 - Fase C: ContinuousLearner. Al cerrar cada trade, el LLM local extrae una
# leccion razonada (por que gano/perdio) -> tabla trade_lessons; agrupa las repetidas y,
# si N comparten clave, PROPONE una revision por Telegram (NO la aplica solo). La leccion
# requiere ENABLE_LLM_ADVISOR=true. Opt-in OFF, soft-fail, read/registro: no toca
# ejecucion ni el gate. STORE_TRADE_LESSONS gatea la persistencia (default true).
ENABLE_CONTINUOUS_LEARNER=false
STORE_TRADE_LESSONS=true

# Phase v3.3.0 - Performance desde un baseline limpio (comando /performance). NO altera el
# balance real; mide el % realizado de trades EJECUTADOS a MT5 y no-artifact desde esta
# fecha, para ver la cuenta limpia del periodo buggeado de mayo (corregido en v2.6.7-v2.7.1).
# Default ~4 dias post-correccion. Vacio = desde el inicio. Solo medicion read-only.
PERFORMANCE_BASELINE_DATE=2026-06-03

# Phase v3.4.0 - Exit shadow: mide si un trailing stop mejoraria las salidas. Hallazgo:
# forex/oro usan los params de trailing de memecoin (activacion +50% que nunca se alcanza)
# -> no tienen trailing efectivo. Cada ciclo registra el camino de R de los abiertos en
# trade_r_samples; /exit_analysis simula el trailing vs la salida real. SOLO medicion,
# NO cambia ninguna salida. Activalo unos dias para juntar caminos y despues medir.
ENABLE_EXIT_SHADOW=false

# Phase v3.5.0 - Proteccion de capital (lecciones del 10-jun-2026, CPI+BOC).
# CALENDAR GATE: no ejecuta a MT5 (swing ni scalping) si hay un evento high-impact de la
# moneda del par dentro de CALENDAR_BUFFER_MINUTES (conecta el is_safe_window que estaba
# huerfano). Requiere ENABLE_ECONOMIC_CALENDAR=true. Solo baja a paper-only.
ENABLE_CALENDAR_GATE=false
# CAP DE EXPOSICION USD: bloquea ejecutar un candidato que concentre la apuesta neta al
# dolar mas alla del cap (7 posiciones long-USD = 1 sola apuesta que se barre junta).
# Solo bloquea concentracion adicional; reducir el neto siempre pasa. Comando /exposicion.
ENABLE_USD_EXPOSURE_CAP=false
MAX_NET_USD_EXPOSURE=3

# v3.8.0 - Regime gate: baja a paper un trade que pelea la tendencia D1 del simbolo
# (long en regimen 'down' / short en 'up'). Clasifica con regime_filter sobre el
# cache D1 (mt5_historical_cache). Downward-only, soft-fail, solo forex/gold.
# Defensivo: NO crea edge, deja de pelear la tendencia (el slicing mostro longs
# -0.57R vs shorts +1.29R). Necesita el cache D1 poblado (loader/walk-forward).
ENABLE_REGIME_GATE=false

# Phase 4 v2.3.0 - MT5 validation + walk-forward + data quality + CSV
# Broker profile para symbol mapping Yahoo<->MT5 (icmarkets default).
MT5_BROKER_PROFILE=icmarkets
# Walk-forward backtester out-of-sample (detecta curve-fitting).
ENABLE_WALK_FORWARD_BACKTEST=true
WALK_FORWARD_TRAIN_DAYS=14
WALK_FORWARD_TEST_DAYS=7
WALK_FORWARD_SLIDE_DAYS=1
WALK_FORWARD_MIN_TRAIN_SAMPLES=10
# Data quality monitor (gaps + staleness + collector failures).
ENABLE_DATA_QUALITY_MONITOR=true
DATA_QUALITY_CHECK_EVERY_N_CYCLES=10
DATA_QUALITY_STALENESS_MAX_MINUTES=15
DATA_QUALITY_GAP_THRESHOLD_MULTIPLIER=2.0
# CSV exports (outcomes, paper trades, horizons, walk-forward).
ENABLE_CSV_EXPORT=true
CSV_EXPORT_PATH=exports

# Phase 4.5 v2.4.0 - Memecoin Hunter Pro + Bot Mode Toggle
# v3.7.0 - Master del motor de memecoins. En false, el ciclo NI COLECTA memecoins
# (DEX/Gecko) -> libera presupuesto para la bolsa (acciones/forex/oro). Default true.
# (ENABLE_MEMECOIN_TELEGRAM solo silencia las alertas; esto apaga la coleccion.)
ENABLE_MEMECOIN_ENGINE=true
# Early detection via GeckoTerminal new_pools (pools <6h).
ENABLE_EARLY_MEMECOIN_DETECTION=true
MAX_EARLY_POOL_AGE_HOURS=6
# Memecoin Hunter analyzer (holder/lock RPC opcional, volume velocity, anti-rug).
ENABLE_MEMECOIN_HUNTER=true
MEMECOIN_HUNTER_MIN_VOLUME_VELOCITY_RATIO=2.0
# Caps separados early vs mature memecoin Telegram.
MAX_EARLY_MEMECOIN_ALERTS_PER_24H=3
MAX_MATURE_MEMECOIN_ALERTS_PER_24H=2
MAX_EARLY_MEMECOIN_ALERTS_PER_RUN=1
# Learning gate FORZADO ON para memecoins (defensa anti-rug).
FORCE_LEARNING_GATE_FOR_MEMECOIN=true
# Bot mode: trader | alerts_only | hybrid. Override via Telegram /mode o CLI --mode.
BOT_MODE=trader

# Phase 5 v2.5.0 - MT5 demo order_send con confirmacion manual.
# Solo cuenta demo. Real-money trading sigue bloqueado.
ENABLE_MT5_DEMO_TRADING=false
DEMO_ORDER_REQUIRE_CONFIRMATION=true
DEMO_MAX_OPEN_TRADES=10
DEMO_RISK_PER_TRADE_PCT=5.26
DEMO_MAX_LOT=0.01
DEMO_ALLOWED_SYMBOLS=EURUSD,XAUUSD
DEMO_TRADE_REQUEST_TTL_MINUTES=15
# ENABLE_REAL_TRADING: IGNORADO desde v3.9.3 — hardcoded False en settings.py (no se lee
# del env). La barrera real es la validacion de cuenta demo; setear esto no habilita nada.
ENABLE_REAL_TRADING=false

# Phase 5.5 v2.5.4 - auto-confirm demo orders (opt-in).
# false = modo Phase 5 original: bot pide /confirm_demo_trade ID por Telegram
# true  = bot ejecuta order_send a MT5 demo automaticamente sin pedir confirmacion
# Real-money trading sigue bloqueado en ambos modos (ENABLE_REAL_TRADING=false).
ENABLE_AUTO_CONFIRM_DEMO=false

# v2.5.5 - cap separado de riesgo total para forex/gold con demo trading activo.
# Stocks/memecoins paper trades siguen bajo MAX_TOTAL_RISK_PCT (6.0 default).
# Forex/gold (que SI ejecutan a MT5 demo) usan este cap mas amplio para no quedar
# bloqueados cuando stocks paper consumen budget de riesgo simulado.
DEMO_MAX_TOTAL_RISK_PCT=10.0

# Phase 5.5 Bloque B v2.6.0 - Scalping engine (thread dedicado, polling rapido).
# Todo opt-in default OFF. Cuando ENABLE_SCALPING_ENGINE=true:
#   - Thread separado pole MT5 cada SCALPING_POLL_INTERVAL_SECONDS.
#   - Strategy scalping_breakout sobre M1 candles.
#   - Auto-ejecuta a MT5 demo via send_prepared_request (validaciones intactas).
#   - Solo opera SCALPING_ALLOWED_SYMBOLS (recomendado EURUSD,GBPUSD).
#   - Caps independientes del swing engine.
#   - Force-exit a SCALPING_FORCE_EXIT_MINUTES si no hit SL/TP.
# Real-money sigue bloqueado por ENABLE_REAL_TRADING=false.
ENABLE_SCALPING_ENGINE=false
SCALPING_ALLOWED_SYMBOLS=EURUSD,GBPUSD
SCALPING_RISK_PER_TRADE_PCT=1.0
SCALPING_MAX_TRADES_PER_DAY=30
SCALPING_MAX_OPEN_TRADES=3
SCALPING_MAX_DAILY_LOSS_PCT=3.0
SCALPING_FORCE_EXIT_MINUTES=5
SCALPING_POLL_INTERVAL_SECONDS=5
SCALPING_HEARTBEAT_EVERY_N_TRADES=5
SCALPING_SL_PIPS=8
SCALPING_TP_PIPS=12
SCALPING_RANGE_LOOKBACK_BARS=10
# v2.6.6 — Multi-strategy scalping. Ambas ON por default cuando el engine activo.
# Bajar a false para deshabilitar una strategy puntual sin apagar el engine.
ENABLE_SCALPING_BREAKOUT=true
ENABLE_SCALPING_MEAN_REVERSION=true
# Mean-reversion params (BB + RSI sobre M1). Defaults estándar.
SCALPING_MR_BOLLINGER_PERIOD=20
SCALPING_MR_BOLLINGER_STD=2.0
SCALPING_MR_RSI_PERIOD=14
SCALPING_MR_RSI_OVERBOUGHT=70
SCALPING_MR_RSI_OVERSOLD=30

CHAINS_TO_MONITOR=solana,ethereum,base,bsc

# Ubicacion de la DB SQLite. Default: trading_alert_ai.db (raiz del proyecto).
# Mantenela en disco local FUERA de iCloud/OneDrive: la sync genera contencion de
# I/O que ralentiza el bot y los tests y arriesga corrupcion del archivo.
# SQLITE_PATH=C:/Users/tu_usuario/trading_data/trading_alert_ai.db

# Phase v2.7.0 - aprendizaje honesto (realized-R) + proteccion de capital
# Promotion gate: una estrategia ejecuta a MT5 demo solo si NO tiene expectancy
# realizada negativa PROBADA (avg_r<=umbral con n>=min_samples). Los losers
# probados quedan paper-only (SHADOW). Default ON = reduce riesgo. Subtractivo:
# solo previene un order_send, nunca lo causa. Real-money sigue bloqueado.
ENABLE_STRATEGY_PROMOTION_GATE=true
STRATEGY_PROMOTION_MIN_SAMPLES=30
STRATEGY_PROMOTION_MIN_EXPECTANCY_R=0.0
# Cost model: costo round-trip (spread+comision) en % por categoria, restado del
# retorno bruto para que el realized-R (y el gate) reflejen la realidad de MT5.
ENABLE_COST_MODEL=true
COST_ROUNDTRIP_PCT_FOREX=0.02
COST_ROUNDTRIP_PCT_GOLD=0.03
COST_ROUNDTRIP_PCT_STOCK=0.05
COST_ROUNDTRIP_PCT_MEMECOIN=0.5
# Fase 2b: learned_weights + learning_gate aprenden del realized-R de paper_trades
# (no del drift de la alerta). Default ON; drift path queda como fallback.
ENABLE_REALIZED_LEARNING=true

# Phase v2.8.0 - Edge Detection & Protection Layer (slicing por sesion/direccion)
# Medicion ON (no toca ejecucion): expectancy realizada en R por sesion y direccion
# en strategy_performance_sliced, refrescada cada ciclo. Visible con /edge.
ENABLE_EDGE_SLICING=true
EDGE_SLICE_MIN_SAMPLES=30
# Gate sliceado OFF (opt-in): si ON, el promotion gate manda a SHADOW tambien por
# slice (sesion+direccion del trade). El slicing SOLO restringe, nunca promueve.
ENABLE_SLICED_PROMOTION_GATE=false

# Phase v2.9.0 - capa ML hibrida (XGBoost). Complementa las reglas, no reemplaza.
# Master switch OFF por default (opt-in). En modo degradado/soft-fail el sistema se
# comporta EXACTAMENTE igual que sin ML. Requiere xgboost + scikit-learn instalados.
ENABLE_ML_PREDICTOR=false
# Bajo este umbral el modelo no entrena (modo degradado, predict=0.5 neutral).
ML_MIN_TRAIN_SAMPLES=100
# El ML SOLO modula el gate con n>=este umbral (salvaguarda dura: con poca muestra
# entrena y se ve en /ml_status, pero NO toca ninguna decision de ejecucion).
ML_GATE_MIN_SAMPLES=400
# Reentrena 1x/dia si hay >= estos trades nuevos. Si el AUC cae >0.05, revierte.
ML_RETRAIN_MIN_NEW_TRADES=20
# Umbrales ML: >pass pasa normal; low..pass pasa con lot/2; <low paper-only.
ML_CONF_PASS=0.65
ML_CONF_LOW=0.50

# Backtest Replay Harness - v3.6.0 (offline, opt-in / soft-fail). Reproduce la
# historia D1 de MT5 barra por barra con las estrategias REALES y mide R neto de
# costos con pesimismo (anti look-ahead), en tablas backtest_* separadas. NO toca
# el ciclo vivo, NO cuenta para /readiness ni la Fase D. Los params de estrategia
# NO van aca: viven en el config_json de cada run (cada corrida queda autodescrita).
# CLI: python -m app.backtest.replay_harness --config <run.json> --report
ENABLE_BACKTEST_HARNESS=false
BACKTEST_TIMEFRAME=D1
BACKTEST_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,XAUUSD
BACKTEST_COST_MULTIPLIER=1.25
BACKTEST_STRESS_COST_MULTIPLIER=1.5
BACKTEST_SL_SLIPPAGE_ATR=0.05
BACKTEST_INTRABAR_RULE=pessimistic
BACKTEST_MAX_CONFIGS_PER_RUN=9
BACKTEST_WF_TRAIN_MONTHS=24
BACKTEST_WF_TEST_MONTHS=6
